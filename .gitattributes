# Git Normalization
* text=auto eol=lf
*.swift text diff=swift
*.dart text diff=dart
*.png binary
*.jpg binary
*.plist text

# Suppress markup, web addon templates, and build wrappers from Language metrics
*.html linguist-detectable=false
*.html linguist-documentation
aura-flutter/web_addon_directory/** linguist-documentation
aura-flutter/web_addon_directory/** linguist-vendored

# Platform runners & generated files
aura-flutter/ios/** linguist-vendored
aura-flutter/macos/** linguist-vendored
aura-flutter/android/** linguist-vendored
*.lock linguist-generated
*.xcworkspacedata linguist-generated
*.pbxproj linguist-generated
aura-flutter/.metadata linguist-generated
