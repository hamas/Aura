# Git Normalization
* text=auto eol=lf
*.swift text diff=swift
*.dart text diff=dart
*.png binary
*.jpg binary
*.plist text

# GitHub Linguist Overrides
# Exclude platform runners, build configurations, and locks
aura-flutter/ios/** linguist-vendored
aura-flutter/macos/** linguist-vendored
aura-flutter/android/** linguist-vendored
*.lock linguist-generated
*.xcworkspacedata linguist-generated
*.pbxproj linguist-generated

# Exclude large auxiliary Dart files to balance language statistics
aura-flutter/test/** linguist-vendored
aura-flutter/web_addon_directory/** linguist-vendored
aura-flutter/docs/** linguist-documentation
aura-flutter/**/*.g.dart linguist-generated
aura-flutter/**/*.freezed.dart linguist-generated
