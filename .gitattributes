# Git Normalization
* text=auto eol=lf
*.swift text diff=swift
*.dart text diff=dart
*.html text diff=html
*.js text diff=javascript
*.kt text diff=kotlin
*.cpp text diff=cpp
*.png binary
*.jpg binary
*.plist text

# ----------------------------------------------------
# GitHub Linguist: Force Exposure of All Core Languages
# ----------------------------------------------------

# Un-vendor platform implementations so native code is counted
aura-flutter/android/** -linguist-vendored
aura-flutter/web_addon_directory/** -linguist-vendored

# Force GitHub to count Web Addon technologies on the Language Bar
*.html linguist-detectable=true
*.js linguist-detectable=true
*.css linguist-detectable=true

# Keep machine-generated build metadata and lockfiles excluded
*.lock linguist-generated
*.xcworkspacedata linguist-generated
*.pbxproj linguist-generated
aura-flutter/.metadata linguist-generated
